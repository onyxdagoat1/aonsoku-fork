# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy to .env.production on your VPS server
# NEVER commit the actual .env.production file!

# ===========================================
# SUPABASE (Frontend)
# ===========================================
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# NAVIDROME ADMIN
# ===========================================
# Create a strong admin password - this controls user creation
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# ===========================================
# CLOUDFLARE R2 STORAGE
# ===========================================
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Create token with "Object Read & Write" permissions
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=yedits-music

# ===========================================
# DOMAIN (used by services)
# ===========================================
DOMAIN=yedits.net
