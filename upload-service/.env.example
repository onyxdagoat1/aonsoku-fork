# ============================================
# UPLOAD SERVICE CONFIGURATION
# ============================================
# Copy this file to .env and configure your settings
# Do not commit .env to version control

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
# Temporary Upload Directory
# Directory for storing files during upload processing
# Files are moved to MUSIC_LIBRARY_PATH after processing
# Default: /tmp/uploads
UPLOAD_DIR=/tmp/uploads
# CRITICAL: Must match your Navidrome music folder exactly
# Files will be organized as: MUSIC_LIBRARY_PATH/Artist/Album/Track.mp3
# Examples:
#   Linux/Mac: /music or /mnt/music or /home/user/music
#   Windows: C:/Users/YourName/Music
MUSIC_LIBRARY_PATH=/music
# Default: 104857600 (100 MB)
#   50 MB: 52428800
#   100 MB: 104857600
#   200 MB: 209715200
MAX_FILE_SIZE=104857600

# ============================================
# NAVIDROME INTEGRATION
# ============================================
# Navidrome Server URL
NAVIDROME_URL=http://localhost:4533

# Navidrome Admin Credentials
# Used to trigger library scan after upload
# Requires admin privileges
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=your_password_here

# Supported File Formats:
# - MP3 (with metadata editing support), FLAC, M4A, OGG, OPUS, WAV, AAC

# File Organization:
# Uploaded files are automatically organized as:
# MUSIC_LIBRARY_PATH/
#   Artist Name/
#     Album Name/
#       01 - Track Title.mp3
#       02 - Another Track.mp3

# Running the Service:
# - Manual: cd upload-service && npm install && npm start
# - Docker: cd upload-service && docker-compose up -d
